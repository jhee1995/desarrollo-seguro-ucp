<?xml version="1.0" encoding="UTF-8"?>
<!-- Nivel info + consola: para que el log.info() se procese (y, con log4j
     2.14.1, el lookup ${jndi:} del mensaje se evalue -> Log4Shell). -->
<Configuration status="WARN">
  <Appenders>
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{HH:mm:ss} %-5level %logger{1} - %msg%n"/>
    </Console>
  </Appenders>
  <Loggers>
    <Root level="info">
      <AppenderRef ref="Console"/>
    </Root>
  </Loggers>
</Configuration>
