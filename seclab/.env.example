# Copia a .env y define solo lo que uses. scan.sh/notify.sh los leen.
# export $(grep -v '^#' .env | xargs)   para cargarlos en tu shell.

# --- Alertas ---
# SECLAB_WEBHOOK_SLACK=https://hooks.slack.com/services/XXX/YYY/ZZZ
# SECLAB_WEBHOOK_DISCORD=https://discord.com/api/webhooks/XXX/YYY
# SECLAB_TELEGRAM_TOKEN=123456:ABCDEF...
# SECLAB_TELEGRAM_CHAT=-1001234567890

# --- Monitoreo ---
SECLAB_PUSHGATEWAY=http://localhost:9091

# --- Agente de triage (opcional; la IA aconseja, no decide el gate) ---
# ANTHROPIC_API_KEY=sk-ant-...
=======
# Copia este archivo a  seclab/.env  y pega tu API key de IA.
#   cp seclab/.env.example seclab/.env   &&  chmod 600 seclab/.env
#
# seclab/.env esta en .gitignore: NUNCA se sube a git.
# (Tambien puedes dejarlo vacio: el gate preguntara la key de forma oculta
#  la primera vez que corras el escaneo con --ai.)

# --- Opcion A: Groq (gratis) --- registrate en https://console.groq.com
GATE_AI_API_KEY=
# Estos son los valores por defecto, no hace falta descomentarlos:
# GATE_AI_BASE_URL=https://api.groq.com/openai/v1
# GATE_AI_MODEL=llama-3.3-70b-versatile

# --- Opcion B: Kimi / Moonshot --- https://platform.moonshot.ai
# GATE_AI_API_KEY=sk-ms-xxxxxxxx
# GATE_AI_BASE_URL=https://api.moonshot.ai/v1
# GATE_AI_MODEL=kimi-k3
